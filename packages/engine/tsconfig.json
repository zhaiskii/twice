{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "resolveJsonModule": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true, "types": ["vitest/importMeta"]
  },
  "include": ["src", "data", "fixtures"]
}
